datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model Lead {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  fullName      String
  linkedinUrl   String
  jobTitle      String
  company       String
  location      String
  industry      String
  companySize   String?
  followers     Int?
  whyMatch      String
  interestScore Int
  recentPost    String?
  outreachMsg   String?
  searchQuery   String?
  email         String?
  status        String   @default("NEW")
}
